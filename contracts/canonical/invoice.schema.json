{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/contracts/canonical/invoice.schema.json",
  "title": "CanonicalInvoice",
  "description": "Canonical invoice used to generate outbound EDI 810.",
  "type": "object",
  "required": ["schemaVersion", "partnerId", "docType", "correlationId", "invoiceNumber", "invoiceDate", "poNumber", "currency", "lines", "totalAmount"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "partnerId": { "type": "string", "minLength": 1 },
    "docType": { "type": "string", "enum": ["810"] },
    "correlationId": { "type": "string", "format": "uuid" },
    "invoiceNumber": { "type": "string", "minLength": 1 },
    "invoiceDate": { "type": "string", "format": "date" },
    "poNumber": { "type": "string" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["lineNumber", "sku", "quantity", "uom", "unitPrice"],
        "additionalProperties": false,
        "properties": {
          "lineNumber": { "type": "integer", "minimum": 1 },
          "sku": { "type": "string" },
          "description": { "type": "string" },
          "quantity": { "type": "number", "exclusiveMinimum": 0 },
          "uom": { "type": "string" },
          "unitPrice": { "type": "number", "minimum": 0 }
        }
      }
    },
    "totalAmount": { "type": "number", "minimum": 0 }
  }
}
