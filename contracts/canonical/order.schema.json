{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/contracts/canonical/order.schema.json",
  "title": "CanonicalOrder",
  "description": "Canonical purchase order produced from EDI 850 (or API). Internal format; EDI/XML only at the partner edge.",
  "type": "object",
  "required": ["schemaVersion", "partnerId", "docType", "controlNumber", "correlationId", "poNumber", "orderDate", "lines"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "partnerId": { "type": "string", "minLength": 1 },
    "docType": { "type": "string", "enum": ["850"] },
    "controlNumber": { "type": "string", "description": "EDI ISA/GS/ST control number; part of the idempotency key." },
    "correlationId": { "type": "string", "format": "uuid" },
    "poNumber": { "type": "string", "minLength": 1 },
    "orderDate": { "type": "string", "format": "date" },
    "requestedDeliveryDate": { "type": "string", "format": "date" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "shipTo": { "$ref": "#/$defs/address" },
    "billTo": { "$ref": "#/$defs/address" },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/line" }
    },
    "payloadRef": { "type": "string", "description": "Claim-check Blob URI when the original payload exceeds 200 KB." }
  },
  "$defs": {
    "address": {
      "type": "object",
      "required": ["name", "line1", "city", "country"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "line1": { "type": "string" },
        "line2": { "type": "string" },
        "city": { "type": "string" },
        "region": { "type": "string" },
        "postalCode": { "type": "string" },
        "country": { "type": "string", "pattern": "^[A-Z]{2}$" }
      }
    },
    "line": {
      "type": "object",
      "required": ["lineNumber", "sku", "quantity", "uom"],
      "additionalProperties": false,
      "properties": {
        "lineNumber": { "type": "integer", "minimum": 1 },
        "sku": { "type": "string" },
        "description": { "type": "string" },
        "quantity": { "type": "number", "exclusiveMinimum": 0 },
        "uom": { "type": "string", "description": "Unit of measure, e.g. EA, CS." },
        "unitPrice": { "type": "number", "minimum": 0 }
      }
    }
  }
}
