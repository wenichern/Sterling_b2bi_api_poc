{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/contracts/edi-json/x12-810.schema.json",
  "title": "X12Transaction810",
  "description": "X12 810 invoice as JSON. Amounts are decimal numbers; Sterling serializes them per X12 rules.",
  "type": "object",
  "required": ["isa", "gs", "st", "body"],
  "additionalProperties": false,
  "properties": {
    "isa": { "$ref": "x12-common.schema.json#/$defs/isa" },
    "gs": { "$ref": "x12-common.schema.json#/$defs/gs" },
    "st": { "$ref": "x12-common.schema.json#/$defs/st" },
    "body": {
      "type": "object",
      "required": ["header", "items", "total"],
      "additionalProperties": false,
      "properties": {
        "header": {
          "type": "object",
          "required": ["invoiceDate", "invoiceNumber", "poNumber"],
          "additionalProperties": false,
          "properties": {
            "invoiceDate": { "$ref": "x12-common.schema.json#/$defs/date" },
            "invoiceNumber": { "type": "string" },
            "poNumber": { "type": "string" }
          }
        },
        "cur": {
          "type": "object",
          "required": ["currencyCode"],
          "additionalProperties": false,
          "properties": { "currencyCode": { "type": "string", "pattern": "^[A-Z]{3}$" } }
        },
        "parties": { "type": "array", "items": { "$ref": "x12-common.schema.json#/$defs/party" } },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["assignedId", "quantityInvoiced", "uom", "unitPrice", "products"],
            "additionalProperties": false,
            "properties": {
              "assignedId": { "type": "string" },
              "quantityInvoiced": { "type": "number", "exclusiveMinimum": 0 },
              "uom": { "type": "string" },
              "unitPrice": { "type": "number", "minimum": 0 },
              "description": { "type": "string" },
              "products": { "type": "array", "minItems": 1, "items": { "$ref": "x12-common.schema.json#/$defs/product" } }
            }
          }
        },
        "total": {
          "type": "object",
          "required": ["amount"],
          "additionalProperties": false,
          "properties": { "amount": { "type": "number", "minimum": 0 } }
        }
      }
    }
  }
}
